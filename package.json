{
  "name": "nestjs-smsir",
  "version": "2.0.0",
  "description": "NestJS integration for sms.ir - Dependency Injection, forRoot/forRootAsync configuration, and a zero-dependency client for the sms.ir REST API.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mohammad-mirzaie-gh/nestjs-smsir.git"
  },
  "homepage": "https://github.com/mohammad-mirzaie-gh/nestjs-smsir",
  "bugs": {
    "url": "https://github.com/mohammad-mirzaie-gh/nestjs-smsir/issues"
  },
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.json",
    "prepare": "npm run build",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint \"src/**/*.ts\" --fix"
  },
  "keywords": [
    "nestjs",
    "nest",
    "nestjs-module",
    "sms",
    "sms.ir",
    "smsir",
    "otp",
    "sms-gateway",
    "verification-code"
  ],
  "author": "Mohammad Mirzaie",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "@nestjs/common": "^9.0.0 || ^10.0.0 || ^11.0.0",
    "@nestjs/core": "^9.0.0 || ^10.0.0 || ^11.0.0",
    "reflect-metadata": "^0.1.13 || ^0.2.0",
    "rxjs": "^7.0.0"
  },
  "devDependencies": {
    "@nestjs/common": "^10.4.22",
    "@nestjs/core": "^10.4.22",
    "@types/node": "^20.19.43",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^5.0.10",
    "rxjs": "^7.8.2",
    "typescript": "^5.9.3"
  }
}
